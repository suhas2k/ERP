{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?_route=/api/$1" },
    { "source": "/download/(.*)", "destination": "/api/index.js?_route=/download/$1" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/((?!api/|download/).*)", "destination": "/public/$1" }
  ]
}
